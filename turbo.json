{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["OPENBOT_*", "TAVILY_API_KEY"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  },
  "globalEnv": [
    "GITHUB_EVENT_NAME",
    "GITHUB_EVENT_PATH",
    "OPENBOT_ALLOWED_ORIGINS",
    "OPENBOT_DATABASE_URL",
    "OPENBOT_NODE_ID",
    "OPENBOT_NODE_SERVER_URL",
    "OPENBOT_OWNER_PASSWORD",
    "OPENBOT_PORT",
    "npm_config_user_agent",
    "NODE_ENV",
    "CI"
  ],
  "globalDependencies": [
    "scripts/**",
    "apps/server-python/requirements*.lock",
    "packages/harness/distribution.lock",
    "packages/harness/pyproject.toml",
    "packages/harness/scripts/**",
    ".github/workflows/**"
  ]
}
