{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/.turbo",
      "!**/dist",
      "!apps/desktop/out",
      "!apps/desktop/native-runtime",
      "!**/coverage",
      "!**/node_modules",
      "!package-lock.json",
      "!apps/web/dist-demo",
      "!apps/web/dist-client-fixtures"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
