{
  "name": "@openbot/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "employee:publisher-key": "tsx --env-file-if-exists=../../.env src/employee-publisher-key-cli.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "test": "vitest run src --maxWorkers=2",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.49",
    "@ai-sdk/moonshotai": "3.0.45",
    "@ai-sdk/openai": "4.0.66",
    "@hono/node-server": "2.1.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openbot/config": "0.0.0",
    "@openbot/db": "0.0.0",
    "@openbot/domain": "0.0.0",
    "@openbot/logging": "0.0.0",
    "@openbot/policy": "0.0.0",
    "@openbot/protocol": "0.0.0",
    "@openbot/windows-secret-acl": "0.0.0",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@sigstore/core": "4.0.1",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "ai": "7.0.93",
    "filename-reserved-regex": "4.0.1",
    "hono": "4.13.7",
    "html-to-text": "10.0.1",
    "ipaddr.js": "2.5.0",
    "officeparser": "7.8.0",
    "pdfjs-dist": "6.3.289",
    "tesseract.js": "7.0.0",
    "write-file-atomic": "8.0.0",
    "ws": "8.21.3",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/filename-reserved-regex": "3.0.0",
    "@types/html-to-text": "9.0.4",
    "@types/write-file-atomic": "4.0.3",
    "@types/ws": "8.18.1",
    "tsx": "4.23.13"
  }
