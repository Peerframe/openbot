{
  "name": "@openbot/desktop",
  "version": "0.1.0-alpha.8",
  "author": "OpenBot contributors",
  "homepage": "https://github.com/yxflc11/openbot",
  "private": true,
  "description": "Installable OpenBot Desktop client.",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run build:renderer && npm run build:main",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "npm run build:desktop --workspace @openbot/web",
    "package": "npm run build && npm run prepare:native && node scripts/package.mjs",
    "make:installers": "node scripts/make-installers.mjs",
    "package:installers": "npm run package && npm run make:installers",
    "package:preview": "npm run build && npm run prepare:native && node scripts/package.mjs --preview",
    "start": "npm run build && electron .",
    "test": "vitest run src scripts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare:native": "turbo run build --filter=@openbot/server && node scripts/prepare-native-server.mjs"
  },
  "dependencies": {
    "postgres": "3.4.9",
    "write-file-atomic": "8.0.0"
  },
  "devDependencies": {
    "@electron/asar": "4.3.0",
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@openbot/web": "0.0.0",
    "@types/write-file-atomic": "4.0.3",
    "electron": "44.2.0",
    "electron-builder": "26.16.1"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "17.10.0-beta.17",
    "@embedded-postgres/darwin-x64": "17.10.0-beta.17"
  },
  "productName": "OpenBot"
}
