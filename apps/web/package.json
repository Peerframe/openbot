{
  "name": "@openbot/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:desktop": "tsc --noEmit -p tsconfig.json && vite build --mode desktop",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run src --passWithNoTests --maxWorkers=2",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:demo": "tsc --noEmit -p tsconfig.json && vite build --config vite.demo.config.ts",
    "dev:fixtures": "npm run build:fixtures && vite preview --config vite.fixtures.config.ts",
    "build:fixtures": "tsc --noEmit -p tsconfig.json && vite build --config vite.fixtures.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openbot/domain": "0.0.0",
    "@openbot/protocol": "0.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "vite": "8.3.0"
  }
}
