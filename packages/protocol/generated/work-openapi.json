  "components": {
    "schemas": {
      "CreateTask": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "botId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "tokenLimit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "requestKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "scope": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NativeTaskScope"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "botId",
          "objective",
          "tokenLimit",
          "requestKey"
        ],
        "additionalProperties": false
      },
      "EmptyCommand": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "DecideAction": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "intentDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "approved": {
            "type": "boolean"
          }
        },
        "required": [
          "intentDigest",
          "approved"
        ],
        "additionalProperties": false
      },
      "RequestReconciliation": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "intentDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "requestKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "expectedSequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 64
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "intentDigest",
          "requestKey",
          "expectedSequence",
          "reason"
        ],
        "additionalProperties": false
      },
      "RequestCorrection": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "runId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "requestKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "expectedSequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          }
        },
        "required": [
          "runId",
          "instruction",
          "requestKey",
          "expectedSequence"
        ],
        "additionalProperties": false
      },
      "NativeTaskScope": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "const": 1
          },
