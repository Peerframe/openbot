{
  "name": "@openbot/employee-publisher",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Retained offline Owner publisher-key tooling; not a Server runtime.",
  "exports": {
    "./agent-skills": {
      "types": "./dist/agent-skills.d.ts",
      "import": "./dist/agent-skills.js"
    },
    "./sensitive-content": {
      "types": "./dist/sensitive-content.d.ts",
      "import": "./dist/sensitive-content.js"
    },
    "./employee-package": {
      "types": "./dist/employee-package.d.ts",
      "import": "./dist/employee-package.js"
    },
    "./employee-package-content": {
      "types": "./dist/employee-package-content.d.ts",
      "import": "./dist/employee-package-content.js"
    },
    "./publisher-keyring": {
      "types": "./dist/employee-publisher-keyring.d.ts",
      "import": "./dist/employee-publisher-keyring.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run src && node --test ../../scripts/employee-publisher-key.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@openbot/domain": "0.0.0",
    "@openbot/protocol": "0.0.0",
    "@sigstore/core": "4.0.1",
    "filename-reserved-regex": "4.0.1",
    "write-file-atomic": "8.0.0",
    "yaml": "2.9.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/filename-reserved-regex": "3.0.0",
    "@types/write-file-atomic": "4.0.3",
    "tsx": "4.23.13"
  }
}
