# Python product development. Existing TS deployments are not converted automatically.
OPENBOT_POSTGRES_PASSWORD=openbot-development-only
OPENBOT_CONTROL_DATABASE_URL=postgres://openbot:openbot-development-only@127.0.0.1:5432/openbot_python_dev
OPENBOT_CONTROL_OWNER_PASSWORD=replace-with-a-long-random-owner-password
OPENBOT_OWNER_NAME=Owner
OPENBOT_CONTROL_SESSION_TTL_HOURS=12
OPENBOT_CONTROL_COOKIE_MODE=loopback
OPENBOT_CONTROL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPENBOT_CONTROL_OBJECT_ROOT=./data/python-product/objects
OPENBOT_CONTROL_ARTIFACT_ROOT=./data/python-product/artifacts
OPENBOT_CONTROL_MODEL_DIRECTORY=./data/python-product/model
# Work requires an explicitly configured mTLS Temporal service. Without it the API is available
# but Tasks cannot execute. See apps/server-python/README.md and deploy/server/README.md.
# OPENBOT_CONTROL_TEMPORAL_CONFIG_PATH=/absolute/private/path/temporal.json
# Optional search, passed only to the trusted product composition.
# TAVILY_API_KEY=replace-with-your-tavily-key
# Container Compose uses OPENBOT_OWNER_PASSWORD; source development uses the Control-prefixed key.
OPENBOT_OWNER_PASSWORD=replace-with-a-long-random-owner-password
