# Single TypeScript Server development. Existing data is migrated only by the explicit entry.
OPENBOT_POSTGRES_PASSWORD=openbot-development-only
# Keep the existing development database and Compose volume identity during the upgrade.
OPENBOT_TS_DATABASE_URL=postgres://openbot:openbot-development-only@127.0.0.1:5432/openbot_python_dev
OPENBOT_TS_OWNER_PASSWORD=replace-with-a-long-random-owner-password
OPENBOT_OWNER_NAME=Owner
OPENBOT_TS_PUBLIC_ORIGIN=http://127.0.0.1:3001
OPENBOT_TS_OBJECT_ROOT=./data/python-product/objects
OPENBOT_TS_ARTIFACT_ROOT=./data/python-product/artifacts
# Required: explicitly configured mTLS Temporal service. Startup refuses incomplete configuration.
# OPENBOT_CONTROL_TEMPORAL_CONFIG_PATH=/absolute/private/path/temporal.json
# Optional search, passed only to the trusted product composition.
# TAVILY_API_KEY=replace-with-your-tavily-key
# Container Compose uses the following operator-provided configuration.
# OPENBOT_SERVER_PUBLIC_ORIGIN=https://openbot.example.com
# OPENBOT_SERVER_CONFIG_DIRECTORY=/absolute/private/path/server-config
OPENBOT_OWNER_PASSWORD=replace-with-a-long-random-owner-password
