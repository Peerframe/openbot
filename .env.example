OPENBOT_HOST=127.0.0.1
OPENBOT_PORT=3001
# Experimental source-install runtime selection; bootstrap the Python package first.
# This does not enable model inference or install dependencies automatically.
OPENBOT_AGENT_RUNTIME=typescript
OPENBOT_POSTGRES_PASSWORD=openbot-development-only
OPENBOT_DATABASE_URL=postgres://openbot:openbot-development-only@localhost:5432/openbot
OPENBOT_OBJECT_STORE_PATH=./data/objects
# Optional exact loopback MCP endpoints for local plugin development (no wildcard hosts).
# OPENBOT_PLUGIN_LOCAL_ENDPOINTS=http://127.0.0.1:4318/mcp
# The Server creates a private encryption key here; back up this directory together with the DB.
# Existing Desktop-managed services continue using their separately encrypted bootstrap key.
OPENBOT_MODEL_DIRECTORY=./data/model
# Optional standalone Server search. Desktop ignores this generic key; its launcher can explicitly
# provide OPENBOT_DESKTOP_TAVILY_API_KEY instead. Kimi can use its own official search.
# TAVILY_API_KEY=replace-with-your-tavily-key
# Optional experimental signed Employee export. Initialize it with employee:publisher-key first.
# OPENBOT_EMPLOYEE_PUBLISHER_KEYRING_PATH=./data/employee-publisher
# OPENBOT_EMPLOYEE_PUBLISHER_PASSPHRASE_FILE=./data/employee-publisher-secret/passphrase
OPENBOT_LOG_LEVEL=info
# Optional. Trust Forwarded only when the direct peer is this exact single-hop proxy IP.
# OPENBOT_TRUSTED_PROXY_ADDRESS=127.0.0.1

OPENBOT_NODE_ID=local-development-node
OPENBOT_NODE_SERVER_URL=ws://localhost:3001/ws/nodes
# Set this only for the first Node start. Generate it after the Server is running with:
# npm run node:enrollment-token -- local-development-node
# OPENBOT_NODE_ENROLLMENT_TOKEN=obenr_replace_with_the_one_time_value
# The enrolled credential is written to OPENBOT_NODE_WORK_DIRECTORY/identity.json by default.
# Linux desktop user services may explicitly use secret-service; it never falls back to a file.
# OPENBOT_NODE_CREDENTIAL_STORE=secret-service
# OPENBOT_NODE_CREDENTIAL_PATH=./data/node/identity.json
# Environment bearer injection is rejected unless explicitly enabled for an ephemeral file profile.
# OPENBOT_NODE_ALLOW_ENV_CREDENTIAL=true
OPENBOT_NODE_MAX_CONCURRENT_RUNS=1
OPENBOT_NODE_WORK_DIRECTORY=./data/node
# Configure both values to enable the CopilotKit/OpenBot agent-computer adapter.
# OPENBOT_DOCKER_COMPUTER_URL=http://127.0.0.1:4100
# OPENBOT_DOCKER_COMPUTER_TOKEN=replace-with-a-long-random-computer-token
OPENBOT_DOCKER_ALLOW_PRIVATE_HOSTS=false
OPENBOT_OWNER_NAME=Owner
OPENBOT_OWNER_PASSWORD=replace-with-a-long-random-owner-password
OPENBOT_SESSION_TTL_HOURS=12
OPENBOT_SECURE_COOKIES=false
OPENBOT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
