<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Historical direct-Node sketch; not a current installation entry.
     OPENBOT_NODE_TOKEN and the unmanaged executable path are obsolete.
     Use docs/NODE_ENROLLMENT.md for the native SMAppService candidate and its
     remaining distribution qualification. Never put real credentials here. -->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.openbot.node</string>
    <key>ProgramArguments</key>
    <array>
      <string>/usr/local/bin/node</string>
      <string>/usr/local/lib/openbot/apps/node/dist/index.js</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
      <key>OPENBOT_NODE_ID</key>
      <string>replace-with-stable-node-id</string>
      <key>OPENBOT_NODE_SERVER_URL</key>
      <string>wss://replace-with-server/ws/nodes</string>
      <key>OPENBOT_NODE_TOKEN</key>
      <string>replace-with-enrollment-token</string>
      <key>OPENBOT_NODE_MAX_CONCURRENT_RUNS</key>
      <string>1</string>
    </dict>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/usr/local/var/log/openbot-node.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/openbot-node.error.log</string>
  </dict>
</plist>
